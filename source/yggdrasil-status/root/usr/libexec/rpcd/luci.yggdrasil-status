#!/bin/sh
# shellcheck shell=sh disable=SC1091,SC3043
# Target shell is BusyBox ash on OpenWrt: SC3043 ('local' is undefined in
# POSIX sh) does not apply, and SC1091 (sourced files not followed) is
# expected for these fixed OpenWrt system paths.

#
# Dynamic Yggdrasil LAN inventory for OpenWrt.
#
# Lifetime model:
#   - config host         -> persistent row
#   - active DHCPv4 lease -> dynamic row for exactly the lease lifetime
#   - neighbour entries   -> stable-first runtime IPv6 enrichment; never persisted
#   - Yggdrasil peer link -> native node address of a LAN device that runs its
#                            own daemon; remembered for exactly as long as the
#                            row itself lives, in the same storage class as the
#                            row: tmpfs for a lease-backed row, flash for a
#                            config-host row that already survives a reboot
#   - config domain       -> optional canonical Ygg IPv6 + DNS alias
#
# Management model:
#   - Pin   -> create a normal config host (name + MAC)
#   - Pin + reserve IPv4 -> additionally store the current IPv4 reservation
#   - Unpin -> remove the matching single-MAC config host
#   - static IPv4 removal requires explicit confirmation
#   - config domain records are never deleted by Pin/Unpin
#
# Online state:
#   IPv4 ARP OR any known Ygg IPv6 response
#
# No daemon.
# No cron.
# No DB.
# No cache that outlives the rows it belongs to. A row's memory shares that
# row's storage class, so it can never survive longer than the row does.
# No getHostHints as inventory source.
#

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

LAN_NET='lan'
DNS_SUFFIX='home.arpa'
LEASE_FILE='/tmp/dhcp.leases'
DHCP_CONFIG='/etc/config/dhcp'
PIN_SECTION_PREFIX='ygg_status_'
DHCP_LOCK_FILE='/var/lock/yggdrasil-status-dhcp.lock'
NODE_CACHE_FILE='/tmp/yggdrasil-status-nodes'
NODE_STORE_FILE='/etc/yggdrasil-status-nodes'
LAN_CACHE_FILE='/tmp/yggdrasil-status-lan'
LAN_STORE_FILE='/etc/yggdrasil-status-lan'


lower() {
	# 'A-Z'/'a-z', not '[:upper:]'/'[:lower:]': the POSIX class form failed on
	# the real BusyBox target (see AI_CONTEXT.md 13.1) — do not "simplify" this.
	# shellcheck disable=SC2018,SC2019
	printf '%s' "$1" | tr 'A-Z' 'a-z'
}


normalize_mac() {
	lower "${1%% *}"
}


valid_mac() {
	printf '%s\n' "$1" | grep -Eq '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$'
}


valid_hostname() {
	local vh_name="$1"

	[ -n "$vh_name" ] || return 1
	[ "${#vh_name}" -le 63 ] || return 1

	case "$vh_name" in
		-*|*-|*[!A-Za-z0-9-]*) return 1 ;;
	esac

	return 0
}


first_ipv4() {
	local fi_value="$1"
	local fi_token

	fi_value="$(printf '%s' "$fi_value" | tr ',' ' ')"

	for fi_token in $fi_value; do
		if valid_ipv4 "$fi_token"; then
			printf '%s\n' "$fi_token"
			return 0
		fi
	done

	return 1
}


valid_ipv4() {
	printf '%s\n' "$1" | awk -F. '
		NF != 4 { exit 1 }
		{
			for (i = 1; i <= 4; i++) {
				if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255)
					exit 1
			}
		}
	'
}


mac_was_emitted() {
	local mwe_mac
	mwe_mac="$(normalize_mac "$1")"

	case "$EMITTED_MACS" in
		*"|${mwe_mac}|"*) return 0 ;;
	esac

	return 1
}


remember_emitted_mac() {
	local rem_mac
	rem_mac="$(normalize_mac "$1")"
	EMITTED_MACS="${EMITTED_MACS}|${rem_mac}|"
}


# The subset of emitted MACs whose row came from a config host. Those rows are
# stored on flash themselves, so what is remembered about them may be too.
remember_persistent_mac() {
	local rpm_mac
	rpm_mac="$(normalize_mac "$1")"
	PERSISTENT_MACS="${PERSISTENT_MACS}|${rpm_mac}|"
}


lease_is_active() {
	local lia_expiry="$1"

	case "$lia_expiry" in
		''|*[!0-9]*) return 1 ;;
		0) return 0 ;;
	esac

	[ "$lia_expiry" -gt "$NOW" ]
}


acquire_dhcp_lock() {
	local adl_mode="$1"

	exec 9>>"$DHCP_LOCK_FILE" || return 1
	case "$adl_mode" in
		shared) flock -s 9 ;;
		*) flock -n 9 ;;
	esac
}


# Return success when a config host contains options beyond the small set that
# this page can safely reason about. Such sections are still shown as
# persistent, but automatic Unpin is disabled so tags, DUID/hostid settings or
# other DHCP policy cannot be removed accidentally.
host_section_has_extra_options() {
	local hse_selector="$1"
	local hse_line

	while IFS= read -r hse_line; do
		[ -n "$hse_line" ] || continue

		case "$hse_line" in
			"dhcp.${hse_selector}=host"|\
			"dhcp.${hse_selector}.name="*|\
			"dhcp.${hse_selector}.mac="*|\
			"dhcp.${hse_selector}.ip="*|\
			"dhcp.${hse_selector}.hostid="*|\
			"dhcp.${hse_selector}.duid="*)
				;;
			*)
				return 0
				;;
		esac
	done <<EOF
$(uci -q show "dhcp.${hse_selector}" 2>/dev/null)
EOF

	return 1
}


# Locate persistent config-host metadata by MAC.
#
# Safety invariants for Unpin:
#   - a section containing multiple MACs is never deleted here;
#   - a MAC present in multiple host sections is never deleted here;
#   - a section with extra/unknown options is never deleted here.
#
# This prevents a status-page action from silently destroying unrelated DHCP
# policy.
match_host_section_by_mac() {
	local mh_section="$1"
	local mh_wanted="$2"
	local mh_macs mh_candidate mh_count=0 mh_matched=0

	config_get mh_macs "$mh_section" mac
	[ -n "$mh_macs" ] || return 0

	mh_macs="$(printf '%s' "$mh_macs" | tr ',' ' ')"

	for mh_candidate in $mh_macs; do
		mh_count=$((mh_count + 1))
		if [ "$(normalize_mac "$mh_candidate")" = "$(normalize_mac "$mh_wanted")" ]; then
			mh_matched=1
		fi
	done

	[ "$mh_matched" -eq 1 ] || return 0

	FOUND_HOST_MATCH_COUNT=$((FOUND_HOST_MATCH_COUNT + 1))

	# Keep metadata from the first matching section, but continue scanning to
	# detect duplicate host sections that refer to the same MAC.
	[ -z "$FOUND_HOST_SECTION" ] || return 0

	FOUND_HOST_SECTION="$mh_section"
	FOUND_HOST_SELECTOR="$mh_section"
	FOUND_HOST_MAC_COUNT="$mh_count"
	config_get FOUND_HOST_NAME "$mh_section" name
	config_get FOUND_HOST_IP "$mh_section" ip
	config_get FOUND_HOST_HOSTID "$mh_section" hostid
}


find_host_by_mac() {
	FOUND_HOST_SECTION=''
	FOUND_HOST_SELECTOR=''
	FOUND_HOST_NAME=''
	FOUND_HOST_IP=''
	FOUND_HOST_MAC_COUNT=0
	FOUND_HOST_MATCH_COUNT=0
	FOUND_HOST_MANAGED=0
	FOUND_HOST_STATIC_IPV4=''
	FOUND_HOST_HOSTID=''
	FOUND_HOST_COMPLEX=0
	FOUND_HOST_AMBIGUOUS=0

	config_foreach match_host_section_by_mac host "$1"

	[ -n "$FOUND_HOST_SECTION" ] || return 1

	case "$FOUND_HOST_SECTION" in
		${PIN_SECTION_PREFIX}*) FOUND_HOST_MANAGED=1 ;;
	esac

	FOUND_HOST_STATIC_IPV4="$(first_ipv4 "$FOUND_HOST_IP" 2>/dev/null || true)"
	[ "$FOUND_HOST_MATCH_COUNT" -gt 1 ] && FOUND_HOST_AMBIGUOUS=1
	if host_section_has_extra_options "$FOUND_HOST_SELECTOR"; then
		FOUND_HOST_COMPLEX=1
	fi

	return 0
}


# Find the active DHCP lease for a MAC. Used by Pin so that the optional static
# reservation always comes from the currently remembered lease, never from a
# stale UI value supplied by the browser.
find_active_lease_by_mac() {
	local fal_wanted fal_expiry fal_mac fal_ip fal_name fal_clientid fal_rest

	LEASE_MATCH_IPV4=''
	LEASE_MATCH_NAME=''
	fal_wanted="$(normalize_mac "$1")"

	[ -r "$LEASE_FILE" ] || return 1

	# fal_clientid/fal_rest are unused but required so read() splits the
	# dhcp.leases fields (expiry mac ip hostname clientid...) correctly.
	# shellcheck disable=SC2034
	while IFS=' ' read -r fal_expiry fal_mac fal_ip fal_name fal_clientid fal_rest; do
		[ -n "$fal_mac" ] || continue
		lease_is_active "$fal_expiry" || continue
		[ "$(normalize_mac "$fal_mac")" = "$fal_wanted" ] || continue

		LEASE_MATCH_IPV4="$fal_ip"
		LEASE_MATCH_NAME="$fal_name"
		[ "$LEASE_MATCH_NAME" = '*' ] && LEASE_MATCH_NAME=''
		return 0
	done < "$LEASE_FILE"

	return 1
}


# Canonical record lookup. A matching config domain is optional.
find_canonical_domain() {
	local fcd_host="$1"
	local fcd_wanted fcd_i fcd_name fcd_ip

	CANONICAL_IPV6=''
	DNS_ALIAS=''

	[ -n "$fcd_host" ] || return 1

	fcd_wanted="$(lower "$fcd_host").${DNS_SUFFIX}"
	fcd_i=0

	while uci -q get "dhcp.@domain[$fcd_i]" >/dev/null 2>&1; do
		fcd_name="$(uci -q get "dhcp.@domain[$fcd_i].name" 2>/dev/null)"
		fcd_ip="$(uci -q get "dhcp.@domain[$fcd_i].ip" 2>/dev/null)"

		if [ -n "$fcd_name" ] && [ "$(lower "$fcd_name")" = "$fcd_wanted" ]; then
			case "$fcd_ip" in
				*:*)
					CANONICAL_IPV6="$fcd_ip"
					DNS_ALIAS="$fcd_name"
					return 0
					;;
			esac
		fi

		fcd_i=$((fcd_i + 1))
	done

	return 1
}


# Locate the logical netifd interface backed by the Yggdrasil proto handler.
select_ygg_network() {
	local syn_section="$1"
	local syn_proto

	[ -z "$YGG_NET" ] || return 0
	config_get syn_proto "$syn_section" proto
	[ "$syn_proto" = 'yggdrasil' ] || return 0
	YGG_NET="$syn_section"
}


# Determine the routed /64 delegated by the Yggdrasil netifd interface. This
# deliberately does not select the first global /64 from br-lan: WAN prefix
# delegation or another overlay may legitimately add more prefixes later.
find_lan_ygg_prefix() {
	local flyp_addr

	[ -n "$YGG_NET" ] || return 0

	# netifd labels a delegated prefix with the name of the interface that
	# provided it, so the class is whatever the Yggdrasil section is called:
	# 'ygg' for the original deployment, 'ygg0' for the documented name today.
	# Match the class of the interface already identified as the Yggdrasil one,
	# then fall back to its first published prefix, which is correct for any
	# naming. This still never picks an arbitrary global /64 off br-lan.
	flyp_addr="$(
		ubus call "network.interface.${YGG_NET}" status 2>/dev/null |
			jsonfilter -e "@[\"ipv6-prefix\"][@.class=\"${YGG_NET}\"].address" 2>/dev/null |
			head -n 1
	)"

	[ -n "$flyp_addr" ] || flyp_addr="$(
		ubus call "network.interface.${YGG_NET}" status 2>/dev/null |
			jsonfilter -e '@["ipv6-prefix"][*].address' 2>/dev/null |
			head -n 1
	)"

	printf '%s\n' "$flyp_addr" |
		awk '
			NF {
				split($1, h, ":")
				if (h[1] != "" && h[2] != "" && h[3] != "" && h[4] != "") {
					print tolower(h[1] ":" h[2] ":" h[3] ":" h[4] ":")
					exit
				}
			}
		'
}


# "<duid>[%iaid] <mac>" for every config host that names both, so a lease can be
# attributed to the MAC the operator tied its DUID to. The IAID, when the
# section has one, is normalised the way odhcpd reads it (hex, no leading
# zeros); a section without one stands for every interface of that DUID.
collect_host_duids() {
	HOST_DUID_MACS=''
	config_foreach collect_host_duid host
}

collect_host_duid() {
	local chd_section="$1"
	local chd_duids chd_macs chd_d chd_m chd_base chd_iaid

	config_get chd_duids "$chd_section" duid
	config_get chd_macs "$chd_section" mac
	[ -n "$chd_duids" ] && [ -n "$chd_macs" ] || return 0

	for chd_d in $(printf '%s' "$chd_duids" | tr ',' ' '); do
		chd_d="$(lower "$chd_d")"
		chd_base="${chd_d%%%*}"
		chd_iaid=''
		case "$chd_d" in
			*%*) chd_iaid="$(printf '%s' "${chd_d#*%}" | sed 's/^0*//')"; chd_iaid="%${chd_iaid:-0}" ;;
		esac
		for chd_m in $(printf '%s' "$chd_macs" | tr ',' ' '); do
			# newline-separated; the test loader stops at a line starting with '}'
			HOST_DUID_MACS="$(printf '%s\n%s %s' "$HOST_DUID_MACS" "${chd_base}${chd_iaid}" "$(normalize_mac "$chd_m")" | sed '/^$/d')"
		done
	done
}

# The MAC a config host ties to a DUID ($1, lower-case hex) and IAID ($2, hex
# without leading zeros). An exact DUID%IAID section wins over a DUID-only one.
host_mac_for_duid() {
	[ -n "${HOST_DUID_MACS:-}" ] || return 0
	printf '%s\n' "$HOST_DUID_MACS" | awk -v d="$1" -v i="$2" '
		$1 == d "%" i { print $2; exit }
		$1 == d && !any { any = $2 }
		END { if (any != "") print any }
	'
}

# Bound DHCPv6 leases from odhcpd, one "<mac> <address> <hostname|->" line each,
# limited to the routed prefix. The MAC is the one a config host ties to the lease's DUID
# (the operator's word: a DUID-UUID or DUID-EN client has no MAC of its own in
# the DUID), otherwise the one inside the DUID the way odhcpd itself matches a
# config host by MAC: a 14-byte DUID-LLT (type 1) carries it in the last six
# bytes, a 10-byte DUID-LL (type 3) in the last six as well. A lease with any
# other DUID and no config host attributes to nothing here. odhcpd is the
# router's own record of what it handed out, so a lease outranks every
# observed address.
collect_dhcpv6_leases() {
	local cdl_lease cdl_duid cdl_iaid cdl_mac cdl_addr cdl_name

	DHCPV6_LEASES=''
	[ -n "$LAN_YGG_PREFIX" ] || return 0

	DHCPV6_LEASES="$(while IFS= read -r cdl_lease; do
		[ -n "$cdl_lease" ] || continue
		# odhcpd lists offers it made beside leases clients took; only a
		# bound one is an address the client actually holds
		printf '%s' "$cdl_lease" | jsonfilter -e '@.flags[*]' 2>/dev/null | grep -qx 'bound' || continue
		cdl_duid="$(printf '%s' "$cdl_lease" | jsonfilter -e '@.duid' 2>/dev/null | tr 'A-F' 'a-f')"
		# ubus prints the IAID as a signed decimal; odhcpd's config wants hex
		cdl_iaid="$(printf '%s' "$cdl_lease" | jsonfilter -e '@.iaid' 2>/dev/null)"
		case "$cdl_iaid" in
			''|*[!0-9-]*) cdl_iaid='' ;;
			*) cdl_iaid="$(printf '%x' $(( cdl_iaid & 0xffffffff )))" ;;
		esac
		cdl_name="$(printf '%s' "$cdl_lease" | jsonfilter -e '@.hostname' 2>/dev/null | tr -d ' ')"
		valid_hostname "$cdl_name" || cdl_name='-'
		cdl_mac="$(host_mac_for_duid "$cdl_duid" "$cdl_iaid")"
		if [ -z "$cdl_mac" ]; then
			case "${#cdl_duid}:$cdl_duid" in
				28:0001*|20:0003*) cdl_mac="${cdl_duid#"${cdl_duid%????????????}"}" ;;
				*) continue ;;
			esac
			# an all-zero link-layer address is a firmware bug, not an identity
			[ "$cdl_mac" != '000000000000' ] || continue
			cdl_mac="$(printf '%s' "$cdl_mac" | sed 's/\(..\)/\1:/g; s/:$//')"
		fi
		printf '%s' "$cdl_lease" | jsonfilter -e '@["ipv6-addr"][*].address' 2>/dev/null |
			while IFS= read -r cdl_addr || [ -n "$cdl_addr" ]; do
				[ -n "$cdl_addr" ] || continue
				cdl_addr="$(lower "$cdl_addr")"
				case "$cdl_addr" in
					"$LAN_YGG_PREFIX"*) printf '%s %s %s\n' "$cdl_mac" "$cdl_addr" "$cdl_name" ;;
				esac
			done
	done <<EOF
$(ubus call dhcp ipv6leases 2>/dev/null | jsonfilter -e '@.device[*].leases[*]' 2>/dev/null)
EOF
)"
}

# The lease addresses attributed to one MAC, in lease order.
dhcpv6_lease_for_mac() {
	local dlm_wanted
	dlm_wanted="$(normalize_mac "$1")"
	[ -n "${DHCPV6_LEASES:-}" ] || return 0
	printf '%s\n' "${DHCPV6_LEASES:-}" | awk -v wanted="$dlm_wanted" '$1 == wanted { print $2 }'
}

# A REACHABLE neighbor entry is a recent kernel-confirmed success, so avoid
# spawning another probe for it. STALE/DELAY/PROBE/FAILED are not treated as
# Online or Offline; those states still fall through to an active probe.
neighbor_recently_reachable() {
	local nrr_addr="$1"

	case "$nrr_addr" in
		*:*) ip -6 neigh show to "$nrr_addr" dev "$LAN_DEV" 2>/dev/null ;;
		*)   ip neigh show to "$nrr_addr" dev "$LAN_DEV" 2>/dev/null ;;
	esac | grep -qw 'REACHABLE'
}


# Runtime SLAAC addresses associated with a MAC in the kernel neighbor table.
# These are enrichment only and are never written to UCI or a cache.
observed_ipv6_for_mac() {
	local o6_wanted="$1"

	[ -n "$LAN_YGG_PREFIX" ] || return 0

	ip -6 neigh show dev "$LAN_DEV" 2>/dev/null |
		awk -v wanted="$(normalize_mac "$o6_wanted")" -v prefix="$LAN_YGG_PREFIX" '
		{
			addr = tolower($1)
			mac = ""

			for (i = 1; i <= NF; i++) {
				if ($i == "lladdr" && (i + 1) <= NF) {
					mac = tolower($(i + 1))
					break
				}
			}

			if (mac != wanted)
				next

			if (index(addr, prefix) != 1)
				next

			if (!seen[addr]++)
				print $1
		}
	'
}


# Resolve a LAN neighbour address to its MAC. Used to attribute a Yggdrasil
# peer link to a device this inventory already knows by MAC.
mac_for_neighbor() {
	local mfn_addr="$1"

	case "$mfn_addr" in
		*:*) ip -6 neigh show to "$mfn_addr" dev "$LAN_DEV" 2>/dev/null ;;
		*)   ip neigh show to "$mfn_addr" dev "$LAN_DEV" 2>/dev/null ;;
	esac | awk '
		{
			for (i = 1; i <= NF; i++) {
				if ($i == "lladdr" && (i + 1) <= NF) {
					print tolower($(i + 1))
					exit
				}
			}
		}
	'
}


# Emit "<peer-endpoint-address> <native-node-address>" for every established
# peer link whose transport endpoint is on this LAN.
#
# A LAN device running its own daemon peers with the router, normally through
# multicast discovery, so the peer URI carries that device's link-local address
# with the LAN device as its zone (percent-encoded), or its LAN IP for an
# explicitly configured peering. Non-literal and off-LAN endpoints are dropped
# here because they cannot belong to a LAN client row.
ygg_peer_endpoints() {
	yggdrasilctl -endpoint="unix:///tmp/yggdrasil/${YGG_NET}.sock" \
		-json getPeers 2>/dev/null |
		jsonfilter -e '@.peers[*]' 2>/dev/null |
		awk -v dev="$LAN_DEV" '
		# Every "name": "value" pair of one peer object.
		function parse_pairs(line,   rest, pair, name, value) {
			pair_count = 0
			rest = line

			while (match(rest, /"[A-Za-z_][A-Za-z0-9_]*"[ \t]*:[ \t]*"[^"]*"/) > 0) {
				pair = substr(rest, RSTART, RLENGTH)
				rest = substr(rest, RSTART + RLENGTH)

				name = pair
				sub(/"[ \t]*:.*$/, "", name)
				sub(/^"/, "", name)

				value = pair
				sub(/^"[A-Za-z_][A-Za-z0-9_]*"[ \t]*:[ \t]*"/, "", value)
				sub(/"$/, "", value)
				gsub(/\\\//, "/", value)

				pair_count++
				pair_name[pair_count] = name
				pair_value[pair_count] = value
			}
		}

		function named(wanted,   want, i, j) {
			split(wanted, want, " ")

			for (j = 1; j in want; j++)
				for (i = 1; i <= pair_count; i++)
					if (pair_name[i] == want[j] && pair_value[i] != "")
						return pair_value[i]

			return ""
		}

		function shaped(pattern,   i) {
			for (i = 1; i <= pair_count; i++)
				if (pair_value[i] ~ pattern)
					return pair_value[i]

			return ""
		}

		# A field is read by name when the name is one this code knows, and by
		# shape otherwise: a transport URI and a 0200::/8 node address are both
		# unambiguous on sight. Upstream has renamed these fields before, so a
		# rename must degrade to shape matching, never to an empty column.
		{
			if ($0 ~ /"up"[ \t]*:[ \t]*false/)
				next

			parse_pairs($0)

			remote = named("remote endpoint uri url")
			if (remote !~ /:\/\//)
				remote = shaped("^[A-Za-z0-9.+-]+://")

			address = named("address ip ipv6 addr")
			if (address !~ /^0?2[0-9a-fA-F][0-9a-fA-F]:/)
				address = shaped("^0?2[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F:]+$")

			if (remote == "" || address == "")
				next

			sub(/^[A-Za-z0-9.+-]+:\/\//, "", remote)

			if (substr(remote, 1, 1) == "[") {
				end = index(remote, "]")
				if (end < 3)
					next
				host = substr(remote, 2, end - 2)
			}
			else {
				host = remote
				sub(/:[0-9]+$/, "", host)
			}

			gsub(/%25/, "%", host)
			zone = ""
			separator = index(host, "%")
			if (separator > 0) {
				zone = substr(host, separator + 1)
				host = substr(host, 1, separator - 1)
			}

			if (zone != "" && zone != dev)
				next

			if (host !~ /:/ && host !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/)
				next

			if (host ~ /[^0-9A-Fa-f:.]/)
				next

			print tolower(host) " " tolower(address)
		}
	'
}


# "<mac> <native-node-address>" for each LAN peer link, deduplicated: a device
# normally appears twice, once inbound and once outbound.
ygg_node_rows() {
	local ynr_host ynr_address ynr_mac

	ygg_peer_endpoints |
		while read -r ynr_host ynr_address; do
			[ -n "$ynr_host" ] || continue

			ynr_mac="$(mac_for_neighbor "$ynr_host")"
			valid_mac "$ynr_mac" || continue

			printf '%s %s 1\n' "$ynr_mac" "$ynr_address"
		done |
		awk '!seen[$0]++'
}


# Native node addresses of LAN devices that run Yggdrasil themselves, keyed by
# MAC. Runtime enrichment exactly like NDP: it never creates a row, never
# extends a row lifetime and is never persisted.
collect_ygg_nodes() {
	YGG_NODE_ROWS=''

	[ -n "$YGG_NET" ] || return 0
	[ -S "/tmp/yggdrasil/${YGG_NET}.sock" ] || return 0
	command -v yggdrasilctl >/dev/null 2>&1 || return 0
	command -v jsonfilter >/dev/null 2>&1 || return 0

	YGG_NODE_ROWS="$(ygg_node_rows)"
}


# Keep the last known node address of a device that is not peering right now.
#
# The memory is keyed by the same MAC the table merges on and is pruned to the
# rows that still exist, so an address survives exactly as long as its device's
# row does and disappears with it. It is split across two files so that it also
# does not die *before* the row: tmpfs for a lease-backed row, flash for a
# config-host row that survives a reboot on its own.
#
# This replays both memories over the peers observed in this run. Precedence is
# live observation, then tmpfs, then flash, so a device that is peering right
# now always overrides whatever was remembered about it, and a node that changes
# its address is corrected as soon as the router sees the new one.
merge_node_cache() {
	YGG_NODE_ROWS="$(
		printf '%s\n' "$YGG_NODE_ROWS" |
			awk -v cache="$NODE_CACHE_FILE" -v store="$NODE_STORE_FILE" '
			function replay(file,   line, remembered) {
				while ((getline line < file) > 0) {
					split(line, remembered, " ")

					if (remembered[1] == "" || remembered[2] == "")
						continue

					if (remembered[1] in live || remembered[1] in recalled)
						continue

					recalled[remembered[1]] = 1
					print remembered[1] " " remembered[2] " 0"
				}
			}

			NF == 3 {
				live[$1] = 1
				print
				next
			}

			END {
				replay(cache)
				replay(store)
			}
		'
	)"
}


# Rewrite one memory file with the remembered address of every MAC in the given
# list, taking the addresses from one of the "<mac> <address> <live>" tables
# built during this run. The file is replaced only when its content actually
# changes, so the 15-second poll behind an open LuCI tab never writes to flash
# on every tick.
write_address_memory() {
	local wam_file="$1"
	local wam_macs="$2"
	local wam_rows="$3"
	local wam_wanted wam_current wam_temp

	wam_wanted="$(
		printf '%s\n' "$wam_rows" |
			awk -v macs="$wam_macs" '
				NF == 3 && index(macs, "|" $1 "|") > 0 { print $1 " " $2 }
			'
	)" || return 0

	wam_current="$(cat "$wam_file" 2>/dev/null)"
	[ "$wam_wanted" = "$wam_current" ] && return 0

	[ -n "$wam_wanted" ] && wam_wanted="${wam_wanted}
"

	wam_temp="${wam_file}.$$"
	if ! printf '%s' "$wam_wanted" > "$wam_temp" 2>/dev/null; then
		rm -f "$wam_temp"
		return 0
	fi

	mv "$wam_temp" "$wam_file" 2>/dev/null || rm -f "$wam_temp"
}


# Prune every memory to the rows that were actually emitted, so none can
# outlive them: the tmpfs copy covers every row, the flash copy only the
# config-host rows that survive a reboot on their own.
save_address_memory() {
	write_address_memory "$NODE_CACHE_FILE" "$EMITTED_MACS" "$YGG_NODE_ROWS"
	write_address_memory "$NODE_STORE_FILE" "$PERSISTENT_MACS" "$YGG_NODE_ROWS"

	# Without a routed prefix the backend cannot observe an address and cannot
	# replay one either, so this pass has nothing to say about them. Pruning on
	# such a pass would delete a good memory over a transient fault rather than
	# because a row went away - observed for real on a reboot after which netifd
	# had not finished bringing the Yggdrasil interface up, which emptied the
	# flash memory of a pinned device that was sitting right there.
	[ -n "$LAN_YGG_PREFIX" ] || return 0

	write_address_memory "$LAN_CACHE_FILE" "$EMITTED_MACS" "$LAN_ADDR_ROWS"
	write_address_memory "$LAN_STORE_FILE" "$PERSISTENT_MACS" "$LAN_ADDR_ROWS"
}


# The last known routed-prefix addresses of a device the router cannot see in
# its NDP table right now. Unlike the node memory this is replayed per row
# rather than merged up front, because the addresses are gathered per client.
#
# Addresses carrying a prefix other than the current one are dropped on the way
# out: after the router's Yggdrasil identity changes, every address remembered
# under the old routed prefix is dead, and silently showing one would be worse
# than showing nothing.
recall_lan_addresses() {
	local rla_wanted
	rla_wanted="$(normalize_mac "$1")"

	[ -n "$LAN_YGG_PREFIX" ] || return 0

	cat "$LAN_CACHE_FILE" "$LAN_STORE_FILE" 2>/dev/null |
		awk -v wanted="$rla_wanted" -v prefix="$LAN_YGG_PREFIX" '
			$1 == wanted && index(tolower($2), prefix) == 1 && !seen[$2]++ {
				print $2
			}
		'
}


# Ask every device on the LAN to reveal the routed address this page shows.
#
# A silent host's address cannot be derived. RFC 7217 mixes the prefix into the
# interface identifier, so it is neither the identifier in the host's link-local
# address nor the one in its MAC, and a privacy address is random by design. The
# router can only learn it from a packet the device sends.
#
# An echo request to the all-nodes multicast address makes every device answer,
# but sourced from the router's link-local it only produces link-local replies.
# Sourced from the router's own routed address it makes each device reply from
# the address it would use to reach that prefix - exactly the one this page
# reports - and the reply populates the neighbour table.
#
# The replies name the addresses but do not by themselves record them: the
# kernel populates the neighbour table when it transmits, not when it receives.
# Each newly named address therefore gets one unicast probe, and that is what
# stores the address together with the MAC this inventory merges on.
#
# It runs detached, so an open page never waits for it, and only when a row
# actually lacked a current address, so a settled LAN sends nothing at all. The
# addresses it uncovers appear on the next pass.
discover_lan_addresses() {
	local dla_source

	[ "$DISCOVERY_WANTED" -eq 1 ] || return 0
	[ -n "$LAN_YGG_PREFIX" ] || return 0
	[ -n "$LAN_DEV" ] || return 0
	command -v ping >/dev/null 2>&1 || return 0

	dla_source="$(
		ip -6 addr show dev "$LAN_DEV" 2>/dev/null |
			awk -v prefix="$LAN_YGG_PREFIX" '
				$1 == "inet6" && index(tolower($2), prefix) == 1 {
					split($2, dla_own, "/")
					print dla_own[1]
					exit
				}
			'
	)"
	[ -n "$dla_source" ] || return 0

	confirm_discovered_addresses "$dla_source" >/dev/null 2>&1 &
}


# The second half of discovery, kept separate so the detached part is one call.
# The probe count is bounded: a hostile or simply crowded LAN must not turn one
# inventory pass into an unbounded burst of packets.
confirm_discovered_addresses() {
	local cda_source="$1"
	local cda_addr
	local cda_count=0

	# Three requests, not one. A device has to resolve the router's routed
	# address before it can answer from its own, and the reply to the first
	# request is regularly lost while that exchange completes - measured on the
	# test LAN, where a single request drew no replies at all and three drew
	# every device.
	ping -6 -c 3 -W 2 -I "$cda_source" "ff02::1%${LAN_DEV}" 2>/dev/null |
		awk -v prefix="$LAN_YGG_PREFIX" -v own="$cda_source" '
			$3 == "from" {
				cda_seen = $4
				sub(/:$/, "", cda_seen)
				if (tolower(cda_seen) == tolower(own))
					next
				if (index(tolower(cda_seen), prefix) != 1)
					next
				if (!cda_known[cda_seen]++)
					print cda_seen
			}
		' |
		while read -r cda_addr; do
			cda_count=$((cda_count + 1))
			[ "$cda_count" -gt 16 ] && break
			ping -6 -c 1 -W 1 "$cda_addr" >/dev/null 2>&1
		done
}


# Record what this run decided a device's routed addresses are, so the next run
# can replay them. Recalled addresses are recorded again exactly as they were,
# which is what keeps the memory alive while the device stays quiet - and what
# keeps the file byte-identical, so a quiet device never triggers a flash write.
remember_lan_addresses() {
	local rma_mac="$1"
	local rma_live="$2"
	local rma_addr

	for rma_addr in $KNOWN_IPV6; do
		LAN_ADDR_ROWS="${LAN_ADDR_ROWS}${rma_mac} ${rma_addr} ${rma_live}
"
	done
}


ygg_node_is_live() {
	local ynl_wanted
	ynl_wanted="$(normalize_mac "$1")"

	printf '%s\n' "$YGG_NODE_ROWS" |
		awk -v wanted="$ynl_wanted" '
			$1 == wanted && $3 == 1 { found = 1 }
			END { exit found ? 0 : 1 }
		'
}


ygg_node_addresses_for_mac() {
	local yna_wanted
	yna_wanted="$(normalize_mac "$1")"

	[ -n "$YGG_NODE_ROWS" ] || return 0

	printf '%s\n' "$YGG_NODE_ROWS" |
		awk -v wanted="$yna_wanted" '$1 == wanted { print $2 }'
}


eui64_ipv6_for_mac() {
	local e64_mac e64_old_ifs e64_first

	e64_mac="$(normalize_mac "$1")"
	valid_mac "$e64_mac" || return 1

	e64_old_ifs="$IFS"
	IFS=':'
	# Intentional word-splitting: splits the MAC into positional params by ':'.
	# shellcheck disable=SC2086
	set -- $e64_mac
	IFS="$e64_old_ifs"
	[ "$#" -eq 6 ] || return 1

	e64_first="$((0x$1 ^ 2))"
	printf '%s%02x%s:%sff:fe%s:%s%s\n' \
		"$LAN_YGG_PREFIX" "$e64_first" "$2" "$3" "$4" "$5" "$6"
}


append_unique_ipv6() {
	local aui_addr="$1"
	local aui_current

	[ -n "$aui_addr" ] || return 0

	for aui_current in $KNOWN_IPV6; do
		[ "$(lower "$aui_current")" = "$(lower "$aui_addr")" ] && return 0
	done

	KNOWN_IPV6="${KNOWN_IPV6}${KNOWN_IPV6:+ }${aui_addr}"
}


build_known_ipv6() {
	local bki_mac="$1"
	local bki_addr bki_eui64 bki_observed

	KNOWN_IPV6=''
	KNOWN_IPV6_SOURCE=''
	if [ -n "$CANONICAL_IPV6" ]; then
		append_unique_ipv6 "$CANONICAL_IPV6"
		KNOWN_IPV6_SOURCE='canonical'
		return 0
	fi

	bki_eui64="$(eui64_ipv6_for_mac "$bki_mac" 2>/dev/null || true)"
	bki_observed="$(observed_ipv6_for_mac "$bki_mac")"

	# A modified EUI-64 address is stable and unambiguous when the client uses
	# one. Prefer it over privacy IIDs so historical NDP entries do not flood
	# the UI or get kept alive by repeated presence probes. Clients that do not
	# expose EUI-64 (notably privacy-only devices) retain all observed addresses.
	for bki_addr in $bki_observed; do
		if [ -n "$bki_eui64" ] && [ "$(lower "$bki_addr")" = "$bki_eui64" ]; then
			append_unique_ipv6 "$bki_addr"
			KNOWN_IPV6_SOURCE='eui64'
			return 0
		fi
	done

	for bki_addr in $bki_observed; do
		append_unique_ipv6 "$bki_addr"
	done
	[ -n "$KNOWN_IPV6" ] && KNOWN_IPV6_SOURCE='observed'
}


probe_online() {
	local po_ipv4="$1"
	local po_addr

	if [ -n "$po_ipv4" ] && neighbor_recently_reachable "$po_ipv4"; then
		return 0
	fi

	for po_addr in $KNOWN_IPV6; do
		if neighbor_recently_reachable "$po_addr"; then
			return 0
		fi
	done

	if [ -n "$po_ipv4" ] && command -v arping >/dev/null 2>&1; then
		if arping -I "$LAN_DEV" -c 1 -f -w 1 "$po_ipv4" >/dev/null 2>&1; then
			return 0
		fi
	fi

	for po_addr in $KNOWN_IPV6; do
		if ping -6 -c 1 -W 1 "$po_addr" >/dev/null 2>&1; then
			return 0
		fi
	done

	return 1
}


emit_client() {
	local ec_name="$1"
	local ec_mac="$2"
	local ec_ipv4="$3"
	local ec_persistent="$4"
	local ec_lease_expiry="$5"
	local ec_static_ipv4="$6"
	local ec_managed_pin="$7"
	local ec_shared_host="$8"
	local ec_complex_host="$9"
	local ec_ambiguous_host="${10}"
	local ec_reserved_ipv6="${11:-0}"
	local ec_online=0
	local ec_primary_ipv6=''
	local ec_ipv6_live=1
	local ec_lease ec_rest ec_implicit6=0 ec_implicit_addr
	local ec_node_addresses ec_node_primary ec_node_live=0
	local ec_addr ec_protected_host=0

	[ -n "$ec_mac" ] || return 0

	# A config domain is persistent metadata keyed by hostname. Only attach it
	# to a persistent config-host identity; a DHCP-only client can claim an
	# arbitrary hostname and must not inherit another device's canonical record.
	if [ "$ec_persistent" -eq 1 ]; then
		find_canonical_domain "$ec_name" || true
	else
		CANONICAL_IPV6=''
		DNS_ALIAS=''
	fi

	KNOWN_IPV6_SOURCE=''
	build_known_ipv6 "$ec_mac"

	# What odhcpd handed out is the router's own record and outranks anything
	# merely observed: the lease comes first, observed addresses follow (a SLAAC
	# address may still be valid on the client for a while after a switch to
	# DHCPv6). A canonical record still wins; it is the operator's word.
	ec_lease="$(dhcpv6_lease_for_mac "$ec_mac")"
	if [ -z "$CANONICAL_IPV6" ]; then
		if [ -n "$ec_lease" ]; then
			ec_rest="$KNOWN_IPV6"
			KNOWN_IPV6=''
			for ec_addr in $ec_lease; do append_unique_ipv6 "$ec_addr"; done
			for ec_addr in $ec_rest; do append_unique_ipv6 "$ec_addr"; done
			KNOWN_IPV6_SOURCE='dhcpv6'
		fi
	fi

	# A config host with an IPv4 reservation but no hostid reserves an IPv6
	# suffix too while DHCPv6 is served: odhcpd reads the last octet's decimal
	# digits as hex (.235 -> ::235). Report it as reserved when the lease
	# actually landed there; unlike an explicit hostid it does not protect the
	# row from Unpin, which removes the whole section under its confirmation.
	if [ "$ec_reserved_ipv6" -eq 0 ] && [ -n "$ec_static_ipv4" ] && [ -n "$ec_lease" ]; then
		ec_implicit_addr="${LAN_YGG_PREFIX}:${ec_static_ipv4##*.}"
		for ec_addr in $ec_lease; do
			[ "$ec_addr" = "$ec_implicit_addr" ] && ec_implicit6=1
		done
	fi

	# A canonical address is persistent metadata of its own and needs no
	# memory. Anything else came from NDP, which forgets a device that stops
	# talking long before its row expires, so fall back to what was seen last.
	if [ -z "$CANONICAL_IPV6" ] && [ -z "$KNOWN_IPV6" ]; then
		KNOWN_IPV6="$(recall_lan_addresses "$ec_mac")"
		[ -n "$KNOWN_IPV6" ] && { ec_ipv6_live=0; KNOWN_IPV6_SOURCE='remembered'; }
	fi

	ec_primary_ipv6="$CANONICAL_IPV6"
	[ -n "$ec_primary_ipv6" ] || ec_primary_ipv6="${KNOWN_IPV6%% *}"

	# A native node address identifies a self-contained Yggdrasil machine. It
	# is reported separately from the routed-prefix LAN addresses and is never
	# probed for presence: reaching it would test the overlay, not the LAN.
	ec_node_addresses="$(ygg_node_addresses_for_mac "$ec_mac")"
	ec_node_primary="$(printf '%s' "$ec_node_addresses" | head -n 1)"
	if [ -n "$ec_node_primary" ] && ygg_node_is_live "$ec_mac"; then
		ec_node_live=1
	fi

	if probe_online "$ec_ipv4"; then
		ec_online=1
	fi

	# A device that is here but whose address the router cannot currently see
	# is the only reason to disturb the LAN with a discovery probe.
	if [ "$ec_online" -eq 1 ] && [ "$ec_ipv6_live" -eq 0 ]; then
		DISCOVERY_WANTED=1
	elif [ "$ec_online" -eq 1 ] && [ -z "$KNOWN_IPV6" ]; then
		DISCOVERY_WANTED=1
	fi

	json_add_object ""
	json_add_string hostname "$ec_name"
	json_add_string mac "$ec_mac"
	json_add_string ipv4 "$ec_ipv4"
	json_add_string ipv6 "$ec_primary_ipv6"
	json_add_string canonical_ipv6 "$CANONICAL_IPV6"
	json_add_array ipv6_addresses
	for ec_addr in $KNOWN_IPV6; do
		json_add_string "" "$ec_addr"
	done
	json_close_array
	json_add_int ipv6_live "$ec_ipv6_live"
	json_add_string ipv6_source "${KNOWN_IPV6_SOURCE:-}"
	json_add_int reserved_ipv6 "$(( ec_reserved_ipv6 | ec_implicit6 ))"
	json_add_int dhcpv6_served "${DHCPV6_SERVED:-0}"
	json_add_string ygg_node_ipv6 "$ec_node_primary"
	json_add_array ygg_node_addresses
	for ec_addr in $ec_node_addresses; do
		json_add_string "" "$ec_addr"
	done
	json_close_array
	json_add_int ygg_node "$([ -n "$ec_node_primary" ] && echo 1 || echo 0)"
	json_add_int ygg_node_live "$ec_node_live"
	json_add_string dns "$DNS_ALIAS"
	json_add_int online "$ec_online"
	json_add_int persistent "$ec_persistent"
	json_add_int static_ipv4 "$([ -n "$ec_static_ipv4" ] && echo 1 || echo 0)"
	json_add_string reserved_ipv4 "$ec_static_ipv4"
	[ "$ec_shared_host" -eq 1 ] && ec_protected_host=1
	[ "$ec_complex_host" -eq 1 ] && ec_protected_host=1
	[ "$ec_ambiguous_host" -eq 1 ] && ec_protected_host=1
	# A hand-made DHCPv6 reservation is removed where it was made, not as a
	# side effect of Unpin; one this page's Pin wrote goes with the pin.
	[ "$ec_reserved_ipv6" -eq 1 ] && [ "$ec_managed_pin" -ne 1 ] && ec_protected_host=1

	json_add_int managed_pin "$ec_managed_pin"
	json_add_int shared_host "$ec_shared_host"
	json_add_int complex_host "$ec_complex_host"
	json_add_int ambiguous_host "$ec_ambiguous_host"
	json_add_int protected_host "$ec_protected_host"
	json_add_string lease_expiry "$ec_lease_expiry"
	json_close_object

	remember_emitted_mac "$ec_mac"
	[ -n "$CANONICAL_IPV6" ] || remember_lan_addresses "$ec_mac" "$ec_ipv6_live"

	if [ "$ec_persistent" -eq 1 ]; then
		remember_persistent_mac "$ec_mac"
	fi
}


# Dynamic rows: active DHCPv4 leases. Their lifetime is exactly the DHCP lease
# lifetime. No extra history is kept.
emit_dynamic_leases() {
	local ed_expiry ed_mac ed_ipv4 ed_hostname ed_clientid ed_rest
	local ed_name ed_persistent ed_static_ipv4 ed_managed ed_shared ed_complex ed_ambiguous ed_reserved6

	[ -r "$LEASE_FILE" ] || return 0

	# ed_clientid/ed_rest are unused but required so read() splits the
	# dhcp.leases fields (expiry mac ip hostname clientid...) correctly.
	# shellcheck disable=SC2034
	while IFS=' ' read -r ed_expiry ed_mac ed_ipv4 ed_hostname ed_clientid ed_rest; do
		[ -n "$ed_mac" ] || continue
		lease_is_active "$ed_expiry" || continue
		mac_was_emitted "$ed_mac" && continue

		ed_name="$ed_hostname"
		[ "$ed_name" = '*' ] && ed_name=''
		ed_persistent=0
		ed_static_ipv4=''
		ed_managed=0
		ed_shared=0
		ed_complex=0
		ed_ambiguous=0

		ed_reserved6=0

		if find_host_by_mac "$ed_mac"; then
			ed_persistent=1
			[ -n "$FOUND_HOST_NAME" ] && ed_name="$FOUND_HOST_NAME"
			ed_static_ipv4="$FOUND_HOST_STATIC_IPV4"
			ed_managed="$FOUND_HOST_MANAGED"
			[ "$FOUND_HOST_MAC_COUNT" -gt 1 ] && ed_shared=1
			ed_complex="$FOUND_HOST_COMPLEX"
			ed_ambiguous="$FOUND_HOST_AMBIGUOUS"
			[ -n "$ed_static_ipv4" ] && ed_ipv4="$ed_static_ipv4"
			[ -n "${FOUND_HOST_HOSTID:-}" ] && ed_reserved6=1
		fi

		emit_client "$ed_name" "$ed_mac" "$ed_ipv4" "$ed_persistent" "$ed_expiry" "$ed_static_ipv4" "$ed_managed" "$ed_shared" "$ed_complex" "$ed_ambiguous" "$ed_reserved6"
	done < "$LEASE_FILE"
}


# Dynamic rows for clients that hold a bound DHCPv6 lease but no DHCPv4 lease
# (an IPv6-only host). Same identity rule as the DHCPv4 rows - the row is the
# MAC - so only a lease whose MAC is known (DUID-LLT/LL, or a config host that
# ties the DUID to a MAC) makes a row; a DUID-UUID client with neither stays
# invisible until it takes a DHCPv4 lease or is reserved. The row lives as long
# as odhcpd lists the lease as bound.
emit_dynamic_leases6() {
	local el_mac el_addr el_name el_persistent el_static_ipv4 el_managed el_shared el_complex el_ambiguous el_reserved6

	[ -n "${DHCPV6_LEASES:-}" ] || return 0

	# el_addr is unused here: the address reaches the row through
	# dhcpv6_lease_for_mac inside emit_client, like every other lease.
	# shellcheck disable=SC2034
	while IFS=' ' read -r el_mac el_addr el_name; do
		[ -n "$el_mac" ] || continue
		mac_was_emitted "$el_mac" && continue

		[ "$el_name" != '-' ] || el_name=''
		el_persistent=0
		el_static_ipv4=''
		el_managed=0
		el_shared=0
		el_complex=0
		el_ambiguous=0
		el_reserved6=0

		if find_host_by_mac "$el_mac"; then
			el_persistent=1
			[ -n "$FOUND_HOST_NAME" ] && el_name="$FOUND_HOST_NAME"
			el_static_ipv4="$FOUND_HOST_STATIC_IPV4"
			el_managed="$FOUND_HOST_MANAGED"
			[ "$FOUND_HOST_MAC_COUNT" -gt 1 ] && el_shared=1
			el_complex="$FOUND_HOST_COMPLEX"
			el_ambiguous="$FOUND_HOST_AMBIGUOUS"
			[ -n "${FOUND_HOST_HOSTID:-}" ] && el_reserved6=1
		fi

		emit_client "$el_name" "$el_mac" "$el_static_ipv4" "$el_persistent" "" "$el_static_ipv4" "$el_managed" "$el_shared" "$el_complex" "$el_ambiguous" "$el_reserved6"
	done <<EOF
$DHCPV6_LEASES
EOF
}

# Persistent rows without an active DHCP lease. They stay visible as Offline.
emit_persistent_host() {
	local eph_section="$1"
	local eph_macs eph_mac eph_name eph_ipv4 eph_managed eph_shared eph_complex eph_ambiguous eph_reserved6

	config_get eph_macs "$eph_section" mac
	[ -n "$eph_macs" ] || return 0
	eph_macs="$(printf '%s' "$eph_macs" | tr ',' ' ')"

	for eph_mac in $eph_macs; do
		mac_was_emitted "$eph_mac" && continue

		# Re-resolve by MAC so duplicate sections and section safety metadata are
		# computed consistently even for persistent hosts without a live lease.
		find_host_by_mac "$eph_mac" || continue

		eph_name="$FOUND_HOST_NAME"
		eph_ipv4="$FOUND_HOST_STATIC_IPV4"
		eph_managed="$FOUND_HOST_MANAGED"
		eph_shared=0
		[ "$FOUND_HOST_MAC_COUNT" -gt 1 ] && eph_shared=1
		eph_complex="$FOUND_HOST_COMPLEX"
		eph_ambiguous="$FOUND_HOST_AMBIGUOUS"
		eph_reserved6=0
		[ -n "${FOUND_HOST_HOSTID:-}" ] && eph_reserved6=1

		emit_client "$eph_name" "$eph_mac" "$eph_ipv4" 1 "" "$eph_ipv4" "$eph_managed" "$eph_shared" "$eph_complex" "$eph_ambiguous" "$eph_reserved6"
	done
}


rpc_clients() {
	LAN_DEV="$(uci -q get network.${LAN_NET}.device)"
	[ -n "$LAN_DEV" ] || LAN_DEV='br-lan'

	NOW="$(date +%s)"
	YGG_NET=''
	config_load network
	config_foreach select_ygg_network interface
	LAN_YGG_PREFIX="$(find_lan_ygg_prefix)"
	collect_ygg_nodes
	merge_node_cache
	EMITTED_MACS=''
	PERSISTENT_MACS=''
	LAN_ADDR_ROWS=''
	DISCOVERY_WANTED=0

	acquire_dhcp_lock shared || true
	config_load dhcp
	DHCPV6_SERVED=0
	dhcpv6_is_served && DHCPV6_SERVED=1
	collect_host_duids
	collect_dhcpv6_leases

	json_init
	json_add_array clients
	emit_dynamic_leases
	emit_dynamic_leases6
	config_foreach emit_persistent_host host
	json_close_array
	save_address_memory
	discover_lan_addresses
	json_dump
}


json_reply() {
	local jr_ok="$1"
	local jr_code="$2"
	local jr_message="$3"

	json_init
	json_add_int ok "$jr_ok"
	json_add_string code "$jr_code"
	json_add_string message "$jr_message"
	json_dump
}


json_reply_device() {
	local jrd_ok="$1"
	local jrd_code="$2"
	local jrd_message="$3"
	local jrd_mac="$4"
	local jrd_name="$5"
	local jrd_ipv4="$6"
	local jrd_ipv6="${7:-}"

	json_init
	json_add_int ok "$jrd_ok"
	json_add_string code "$jrd_code"
	json_add_string message "$jrd_message"
	json_add_string mac "$jrd_mac"
	json_add_string hostname "$jrd_name"
	json_add_string reserved_ipv4 "$jrd_ipv4"
	json_add_string reserved_ipv6 "$jrd_ipv6"
	json_dump
}


read_request() {
	local rr_input
	rr_input="$(cat)"
	json_load "$rr_input" 2>/dev/null || return 1
	return 0
}


backup_dhcp_config() {
	DHCP_BACKUP="/tmp/yggdrasil-status-dhcp.$$.bak"
	cp -p "$DHCP_CONFIG" "$DHCP_BACKUP" || return 1
}


restore_dhcp_config() {
	[ -n "$DHCP_BACKUP" ] && [ -f "$DHCP_BACKUP" ] || return 0
	cp -p "$DHCP_BACKUP" "$DHCP_CONFIG" || true
	uci -q revert dhcp >/dev/null 2>&1 || true
	/etc/init.d/dnsmasq reload >/dev/null 2>&1 || true
}


finish_dhcp_config() {
	rm -f "$DHCP_BACKUP"
	DHCP_BACKUP=''
}


dhcp_has_pending_changes() {
	[ -n "$(uci -q changes dhcp 2>/dev/null)" ]
}


# Does any interface serve stateful DHCPv6? Then a config host is an IPv6
# reservation too (hostid, or the IID odhcpd derives from an IPv4 ip), and a
# change to it must reach odhcpd, not only dnsmasq.
dhcpv6_is_served() {
	uci -q show dhcp 2>/dev/null | grep -q "\.dhcpv6='server'\$"
}

commit_and_reload_dhcp() {
	if ! uci commit dhcp; then
		restore_dhcp_config
		return 1
	fi

	if ! /etc/init.d/dnsmasq reload >/dev/null 2>&1; then
		restore_dhcp_config
		return 1
	fi

	if dhcpv6_is_served && ! /etc/init.d/odhcpd reload >/dev/null 2>&1; then
		restore_dhcp_config
		/etc/init.d/dnsmasq reload >/dev/null 2>&1
		return 1
	fi

	finish_dhcp_config
	return 0
}


# A hostid the way odhcpd reads it: lower-case hex, no 0x, no leading zeros.
norm_hostid() {
	local nh
	nh="$(printf '%s' "$1" | tr 'A-F' 'a-f' | sed 's/^0x//; s/^0*//')"
	printf '%s' "${nh:-0}"
}

# 1-16 hex digits, not 0 (dynamic to odhcpd) and not 1 (the router's own LAN
# address). Leaves the normalised value in NORM_HOSTID.
valid_hostid() {
	case "$1" in
		'') return 1 ;;
		*[!0-9A-Fa-fxX]*) return 1 ;;
	esac
	NORM_HOSTID="$(norm_hostid "$1")"
	[ "${#NORM_HOSTID}" -le 16 ] || return 1
	case "$NORM_HOSTID" in
		''|0|1|*[!0-9a-f]*) return 1 ;;
	esac
	return 0
}

# Every IPv6 suffix the existing config host sections already claim, one per
# line as "<suffix> <section>": an explicit hostid, or the implicit one odhcpd
# derives from an IPv4 reservation's last octet (.235 -> 235).
collect_taken_hostids() {
	TAKEN_HOSTIDS=''
	config_foreach collect_taken_hostid host
}

collect_taken_hostid() {
	local cth_section="$1"
	local cth_hostid cth_ip cth_id

	config_get cth_hostid "$cth_section" hostid
	config_get cth_ip "$cth_section" ip
	if [ -n "$cth_hostid" ]; then
		[ "$cth_hostid" != 'ignore' ] || return 0
		cth_id="$(norm_hostid "$cth_hostid")"
	elif [ -n "$cth_ip" ]; then
		cth_ip="$(first_ipv4 "$cth_ip" 2>/dev/null || true)"
		[ -n "$cth_ip" ] || return 0
		cth_id="$(norm_hostid "${cth_ip##*.}")"
	else
		return 0
	fi
	TAKEN_HOSTIDS="$(printf '%s\n%s %s' "$TAKEN_HOSTIDS" "$cth_id" "$cth_section" | sed '/^$/d')"
}

# The DUID (with IAID, as odhcpd's config wants it) behind a bound lease whose
# address the neighbour table attributes to this MAC. The device answering
# neighbour solicitations for a leased address is the device holding that
# lease, so this ties a DUID-UUID client to its MAC without guessing.
lease_duid_for_mac() {
	local ldm_wanted ldm_lease ldm_addr ldm_neigh_mac ldm_duid ldm_iaid
	ldm_wanted="$(normalize_mac "$1")"

	# heredoc-fed loops, not pipelines: return must leave the function
	while IFS= read -r ldm_lease; do
		[ -n "$ldm_lease" ] || continue
		printf '%s' "$ldm_lease" | jsonfilter -e '@.flags[*]' 2>/dev/null | grep -qx 'bound' || continue
		while IFS= read -r ldm_addr || [ -n "$ldm_addr" ]; do
			[ -n "$ldm_addr" ] || continue
			ldm_neigh_mac="$(mac_for_neighbor "$(lower "$ldm_addr")")"
			[ "$ldm_neigh_mac" = "$ldm_wanted" ] || continue
			ldm_duid="$(printf '%s' "$ldm_lease" | jsonfilter -e '@.duid' 2>/dev/null | tr 'A-F' 'a-f')"
			ldm_iaid="$(printf '%s' "$ldm_lease" | jsonfilter -e '@.iaid' 2>/dev/null)"
			case "$ldm_iaid" in
				''|*[!0-9-]*) printf '%s\n' "$ldm_duid" ;;
				*) printf '%s%%%x\n' "$ldm_duid" $(( ldm_iaid & 0xffffffff )) ;;
			esac
			return 0
		done <<ADDR_EOF
$(printf '%s' "$ldm_lease" | jsonfilter -e '@["ipv6-addr"][*].address' 2>/dev/null)
ADDR_EOF
	done <<EOF
$(ubus call dhcp ipv6leases 2>/dev/null | jsonfilter -e '@.device[*].leases[*]' 2>/dev/null)
EOF
	return 0
}

rpc_pin() {
	local rp_mac rp_name rp_reserve rp_section rp_ipv4=''
	local rp_reserve6 rp_hostid='' rp_duid='' rp_addr6='' rp_taken

	read_request || {
		json_reply 0 'invalid_request' 'Invalid JSON request.'
		return 0
	}

	json_get_var rp_mac mac
	json_get_var rp_name name
	json_get_var rp_reserve reserve_ipv4
	json_get_var rp_reserve6 reserve_ipv6

	rp_mac="$(normalize_mac "$rp_mac")"

	valid_mac "$rp_mac" || {
		json_reply 0 'invalid_mac' 'Invalid MAC address.'
		return 0
	}

	acquire_dhcp_lock exclusive || {
		json_reply 0 'busy' 'Another DHCP configuration update is already in progress.'
		return 0
	}

	NOW="$(date +%s)"
	config_load dhcp

	if find_host_by_mac "$rp_mac"; then
		json_reply_device 1 'already_persistent' 'Device is already persistent.' "$rp_mac" "$FOUND_HOST_NAME" "$FOUND_HOST_STATIC_IPV4"
		return 0
	fi

	find_active_lease_by_mac "$rp_mac" || {
		json_reply 0 'no_active_lease' 'The device no longer has an active DHCP lease.'
		return 0
	}

	[ -n "$rp_name" ] || rp_name="$LEASE_MATCH_NAME"

	valid_hostname "$rp_name" || {
		json_reply 0 'invalid_hostname' 'Hostname must be 1-63 characters using letters, digits or hyphens, and cannot start or end with a hyphen.'
		return 0
	}

	case "$rp_reserve" in
		1|true)
			rp_ipv4="$LEASE_MATCH_IPV4"
			if ! valid_ipv4 "$rp_ipv4"; then
				json_reply 0 'no_ipv4' 'The active lease does not contain a usable IPv4 address.'
				return 0
			fi
			;;
	esac

	# An IPv6 suffix only means something where odhcpd assigns the addresses.
	case "${rp_reserve6:-}" in ''|false) rp_reserve6='' ;; esac
	if [ -n "$rp_reserve6" ]; then
		dhcpv6_is_served || {
			json_reply 0 'dhcpv6_not_served' 'This router does not serve DHCPv6 on the LAN; an IPv6 reservation would never be handed out.'
			return 0
		}
		valid_hostid "$rp_reserve6" || {
			json_reply 0 'invalid_hostid' 'IPv6 suffix must be 1-16 hex digits, not 0 (dynamic) and not 1 (the router).'
			return 0
		}
		rp_hostid="$NORM_HOSTID"
		collect_taken_hostids
		rp_taken="$(printf '%s\n' "$TAKEN_HOSTIDS" | awk -v id="$rp_hostid" '$1 == id { print $2; exit }')"
		if [ -n "$rp_taken" ]; then
			json_reply 0 'hostid_taken' "IPv6 suffix ::${rp_hostid} is already reserved by config host ${rp_taken}."
			return 0
		fi
		# Tie the DUID to the pin when the device already holds a lease, so a
		# DUID-UUID client (NetworkManager) matches; a DUID-LLT/LL client is
		# matched by MAC anyway.
		LAN_DEV="$(uci -q get network.${LAN_NET}.device)"
		[ -n "$LAN_DEV" ] || LAN_DEV='br-lan'
		rp_duid="$(lease_duid_for_mac "$rp_mac")"
	fi

	rp_section="${PIN_SECTION_PREFIX}$(printf '%s' "$rp_mac" | tr -d ':')"

	if dhcp_has_pending_changes; then
		json_reply 0 'pending_uci_changes' 'DHCP has uncommitted UCI changes. Apply or revert them before using Pin/Unpin.'
		return 0
	fi

	if uci -q get "dhcp.${rp_section}" >/dev/null 2>&1; then
		json_reply 0 'section_collision' 'A Yggdrasil status pin section with this name already exists.'
		return 0
	fi

	DHCP_BACKUP=''
	backup_dhcp_config || {
		json_reply 0 'backup_failed' 'Could not back up /etc/config/dhcp.'
		return 0
	}

	if ! uci set "dhcp.${rp_section}=host" ||
	   ! uci set "dhcp.${rp_section}.name=${rp_name}" ||
	   ! uci set "dhcp.${rp_section}.mac=${rp_mac}"; then
		restore_dhcp_config
		finish_dhcp_config
		json_reply 0 'uci_failed' 'Could not create the persistent host entry.'
		return 0
	fi

	if [ -n "$rp_ipv4" ] && ! uci set "dhcp.${rp_section}.ip=${rp_ipv4}"; then
		restore_dhcp_config
		finish_dhcp_config
		json_reply 0 'uci_failed' 'Could not store the IPv4 reservation.'
		return 0
	fi

	if [ -n "$rp_hostid" ]; then
		if ! uci set "dhcp.${rp_section}.hostid=${rp_hostid}" ||
		   { [ -n "$rp_duid" ] && ! uci set "dhcp.${rp_section}.duid=${rp_duid}"; }; then
			restore_dhcp_config
			finish_dhcp_config
			json_reply 0 'uci_failed' 'Could not store the IPv6 reservation.'
			return 0
		fi
	fi

	if ! commit_and_reload_dhcp; then
		finish_dhcp_config
		json_reply 0 'reload_failed' 'Could not commit/reload DHCP configuration; the previous configuration was restored.'
		return 0
	fi

	if [ -n "$rp_hostid" ]; then
		YGG_NET=''
		config_load network
		config_foreach select_ygg_network interface
		LAN_YGG_PREFIX="$(find_lan_ygg_prefix)"
		[ -n "$LAN_YGG_PREFIX" ] && rp_addr6="${LAN_YGG_PREFIX}:${rp_hostid}"
		if [ -n "$rp_duid" ]; then
			json_reply_device 1 'pinned' "Device pinned; ${rp_addr6:-::$rp_hostid} reserved for its DUID and MAC. It takes effect when the device next renews or reconnects." "$rp_mac" "$rp_name" "$rp_ipv4" "$rp_addr6"
		else
			json_reply_device 1 'pinned' "Device pinned; ${rp_addr6:-::$rp_hostid} reserved by MAC. No DHCPv6 lease of this device was seen, so the reservation applies only if its DUID carries the MAC (DUID-LLT/LL); otherwise reserve it by DUID with the deployer." "$rp_mac" "$rp_name" "$rp_ipv4" "$rp_addr6"
		fi
		return 0
	fi

	json_reply_device 1 'pinned' 'Device pinned successfully.' "$rp_mac" "$rp_name" "$rp_ipv4"
}


rpc_unpin() {
	local ru_mac ru_confirm ru_static ru_section ru_addr6 ru_msg

	read_request || {
		json_reply 0 'invalid_request' 'Invalid JSON request.'
		return 0
	}

	json_get_var ru_mac mac
	json_get_var ru_confirm confirm_static
	ru_mac="$(normalize_mac "$ru_mac")"

	valid_mac "$ru_mac" || {
		json_reply 0 'invalid_mac' 'Invalid MAC address.'
		return 0
	}

	acquire_dhcp_lock exclusive || {
		json_reply 0 'busy' 'Another DHCP configuration update is already in progress.'
		return 0
	}

	config_load dhcp

	if ! find_host_by_mac "$ru_mac"; then
		json_reply 1 'already_dynamic' 'Device is already dynamic.'
		return 0
	fi

	if [ "$FOUND_HOST_MATCH_COUNT" -gt 1 ]; then
		json_reply 0 'ambiguous_host' 'This MAC appears in more than one config host section. Resolve the duplicate in Network -> DHCP and DNS before using Unpin.'
		return 0
	fi

	if [ "$FOUND_HOST_MAC_COUNT" -gt 1 ]; then
		json_reply 0 'shared_host' 'This config host contains multiple MAC addresses. Unpin it from the standard DHCP configuration to avoid affecting other devices.'
		return 0
	fi

	if [ "$FOUND_HOST_COMPLEX" -eq 1 ]; then
		json_reply 0 'complex_host' 'This config host contains additional DHCP options. Edit it in Network -> DHCP and DNS so those settings are not removed accidentally.'
		return 0
	fi

	# A reservation written by hand (or by the deployer) is removed where it
	# was made; one this page's Pin wrote goes with the pin, under the same
	# confirmation as an IPv4 reservation.
	if [ -n "$FOUND_HOST_HOSTID" ] && [ "$FOUND_HOST_MANAGED" -ne 1 ]; then
		json_reply 0 'reserved_ipv6' 'This device has a DHCPv6 address reservation (hostid). Remove the hostid option in Network -> DHCP and DNS first; the status page does not delete reservations it did not make.'
		return 0
	fi

	ru_static="$FOUND_HOST_STATIC_IPV4"

	if [ -n "$ru_static" ] || [ -n "$FOUND_HOST_HOSTID" ]; then
		case "$ru_confirm" in
			1|true) ;;
			*)
				ru_addr6=''
				if [ -n "$FOUND_HOST_HOSTID" ]; then
					YGG_NET=''
					config_load network
					config_foreach select_ygg_network interface
					LAN_YGG_PREFIX="$(find_lan_ygg_prefix)"
					config_load dhcp
					ru_addr6="${LAN_YGG_PREFIX:+${LAN_YGG_PREFIX}:}$(norm_hostid "$FOUND_HOST_HOSTID")"
					[ -n "$LAN_YGG_PREFIX" ] || ru_addr6="::$ru_addr6"
				fi
				if [ -n "$ru_static" ] && [ -n "$FOUND_HOST_HOSTID" ]; then
					ru_msg='This device has DHCP reservations. Removing this persistent entry will also remove the reserved IPv4 address and the reserved IPv6 suffix.'
				elif [ -n "$FOUND_HOST_HOSTID" ]; then
					ru_msg='This device has a DHCPv6 reservation made from this page. Removing this persistent entry will also remove the reserved IPv6 suffix.'
				else
					ru_msg='This device has a static DHCP reservation. Removing this persistent entry will also remove the reserved IPv4 address and, where DHCPv6 is served, the IPv6 suffix odhcpd derives from it.'
				fi
				json_reply_device 0 'static_confirmation_required' "$ru_msg" "$ru_mac" "$FOUND_HOST_NAME" "$ru_static" "$ru_addr6"
				return 0
				;;
		esac
	fi

	ru_section="$FOUND_HOST_SELECTOR"

	if dhcp_has_pending_changes; then
		json_reply 0 'pending_uci_changes' 'DHCP has uncommitted UCI changes. Apply or revert them before using Pin/Unpin.'
		return 0
	fi

	DHCP_BACKUP=''
	backup_dhcp_config || {
		json_reply 0 'backup_failed' 'Could not back up /etc/config/dhcp.'
		return 0
	}

	if ! uci -q delete "dhcp.${ru_section}"; then
		restore_dhcp_config
		finish_dhcp_config
		json_reply 0 'uci_failed' 'Could not remove the persistent host entry.'
		return 0
	fi

	if ! commit_and_reload_dhcp; then
		finish_dhcp_config
		json_reply 0 'reload_failed' 'Could not commit/reload DHCP configuration; the previous configuration was restored.'
		return 0
	fi

	json_reply_device 1 'unpinned' 'Device unpinned successfully. Any matching config domain record was left untouched.' "$ru_mac" "$FOUND_HOST_NAME" "$ru_static"
}


case "$1" in
	list)
		printf '%s\n' '{"clients":{},"pin":{"mac":"","name":"","reserve_ipv4":false,"reserve_ipv6":""},"unpin":{"mac":"","confirm_static":false}}'
		;;

	call)
		case "$2" in
			clients) rpc_clients ;;
			pin) rpc_pin ;;
			unpin) rpc_unpin ;;
		esac
		;;
esac
