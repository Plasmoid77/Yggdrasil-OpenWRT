#!/bin/sh
set -eu

interface='ygg0'
# The router's Yggdrasil node address and its zone (--dns-domain). The address
# follows the router's node key: after a key change, update it here.
router_dns='<ROUTER_YGG_IPV6>'
zone='home.arpa'

case "${1:-}" in
  apply)
    attempts=0
    while ! /usr/bin/ip link show dev "$interface" >/dev/null 2>&1; do
      attempts=$((attempts + 1))
      [ "$attempts" -lt 100 ] || exit 1
      sleep 0.1
    done

    /usr/bin/resolvectl dns "$interface" "$router_dns"
    /usr/bin/resolvectl domain "$interface" "~$zone"
    /usr/bin/resolvectl default-route "$interface" no
    ;;
  revert)
    /usr/bin/resolvectl revert "$interface" 2>/dev/null || true
    ;;
  *)
    echo "usage: $0 apply|revert" >&2
    exit 2
    ;;
esac
