#!/bin/sh
set -eu

interface='ygg0'
# Where the zones below are resolved: the router's Yggdrasil node address (one
# router; it follows the router's node key, so update it after a key change),
# or 127.0.0.2 for a local dnsmasq that sends each zone to its own router
# (several routers, see dnsmasq-ygg-zones.conf).
router_dns='<ROUTER_YGG_IPV6>'
# The routers' zones (--dns-domain) or a parent of them, space-separated.
zones='home.arpa'

case "${1:-}" in
  apply)
    attempts=0
    while ! /usr/bin/ip link show dev "$interface" >/dev/null 2>&1; do
      attempts=$((attempts + 1))
      [ "$attempts" -lt 100 ] || exit 1
      sleep 0.1
    done

    /usr/bin/resolvectl dns "$interface" "$router_dns"
    # shellcheck disable=SC2046 # one ~zone argument per zone
    /usr/bin/resolvectl domain "$interface" $(printf '~%s ' $zones)
    /usr/bin/resolvectl default-route "$interface" no
    ;;
  revert)
    /usr/bin/resolvectl revert "$interface" 2>/dev/null || true
    ;;
  *)
    echo "usage: $0 apply|revert" >&2
    exit 2
    ;;
esac
